{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FMD Product Metadata Sprint 1",
  "type": "object",
  "properties": {
    "band": {
      "type": ["string", "null"]
    },
    "universe": {
      "type": "array",
      "items": {
        "enum": [
          "Thrash Metal",
          "Megadeth Vault",
          "Heavy Metal Classics",
          "Groove Metal",
          "Rock Legends",
          "Modern Metal",
          "Argentina Heavy",
          "FMD Editions",
          "Custom Archive"
        ]
      },
      "uniqueItems": true
    },
    "album": {
      "type": ["string", "null"]
    },
    "garments": {
      "type": "array",
      "items": {
        "enum": [
          "remera",
          "hoodie",
          "buzo_cuello_redondo"
        ]
      },
      "uniqueItems": true
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "campaigns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "commercialPriority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "visibilityTier": {
      "enum": [
        "hero",
        "featured",
        "catalog",
        "archive",
        "hidden"
      ]
    },
    "legacyCategory": {
      "type": "string"
    }
  },
  "required": [
    "universe",
    "garments",
    "collections",
    "campaigns",
    "commercialPriority",
    "visibilityTier",
    "legacyCategory"
  ],
  "additionalProperties": true
}
