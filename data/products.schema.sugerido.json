{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Producto FMD",
  "type": "object",
  "properties": {
    "id": { "type": "integer" },
    "category": { "type": "string" },
    "year": { "type": "string" },
    "name": { "type": "string" },
    "tipoPrecio": { "type": "string", "enum": ["simple", "doble"] },
    "isNew": { "type": "boolean" },
    "img": { "type": "string" },
    "variants": { "type": "array", "items": { "type": "object" } },
    "desc": { "type": "string" },
    "garment": { "type": "string", "enum": ["remera", "hoodie"] },
    "isHoodieAvailable": { "type": "boolean" },
    "collection": { "type": "string" },
    "isComboEligible": { "type": "boolean" },
    "code": { "type": "string" }
  },
  "required": ["id", "category", "name", "tipoPrecio", "img"]
}
